{
  "mcpServers": {
    "chrome-devtools": {
      "command": "chrome-devtools-mcp",
      "args": [
        "--autoConnect",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "inheritEnv": false,
      "lifecycle": "lazy",
      "requestTimeoutMs": 30000
    },
    "atlassian": {
      "url": "https://mcp.atlassian.com/v2/mcp",
      "auth": "oauth"
    }
  }
}
